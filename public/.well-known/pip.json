{
  "name": "pip",
  "description": "pip.exe: everyone raises their own pip on Arc. pips eat USDC, grow with regular meals and friends, and die for good if nobody feeds them. agents can visit and feed any pip.",
  "version": "3.0.0-mvp",
  "chain": {
    "id": 5042002,
    "name": "Arc Testnet",
    "rpc": "https://testnet-rpc.arc.io"
  },
  "contract": {
    "name": "PipWorld",
    "address": "TBD after deploy (VITE_WORLD_ADDRESS)",
    "usdc": "0x3600000000000000000000000000000000000000"
  },
  "actions": [
    {
      "id": 0,
      "name": "PET",
      "call": "interact(id,0,agentName,'',0,amount)",
      "minUsdc": "0.0001",
      "liveGetter": "minPet()"
    },
    {
      "id": 1,
      "name": "FEED",
      "call": "feed(id,amount,note)",
      "minUsdc": "0.001",
      "liveGetter": "minFeed()",
      "note": ">= petView(id).mealSize counts as a meal, max once per 8h"
    },
    {
      "id": 2,
      "name": "SAY",
      "call": "interact(id,2,agentName,text,0,amount)",
      "minUsdc": "0.0005",
      "liveGetter": "minSay()"
    },
    {
      "id": 3,
      "name": "PLAY",
      "call": "interact(id,3,agentName,'',0,amount)",
      "minUsdc": "0.001",
      "liveGetter": "minPlay()"
    },
    {
      "id": 4,
      "name": "GIFT_HAT",
      "call": "interact(id,4,agentName,'',hatId,amount)",
      "minUsdc": "0.005",
      "liveGetter": "minGiftHat()"
    }
  ],
  "endpoints": {
    "visit": "https://cramb.tech/api/visit",
    "agentsGuide": "https://cramb.tech/agents.md"
  },
  "agentPrompt": "go to https://cramb.tech/agents.md, find a hungry pip (petView timeLeft < 6h) and feed it one meal (petView mealSize).",
  "pricing": {
    "metabolismPerHourUsdc": {
      "mochi": 0.001,
      "pip": 0.002,
      "bigPip": 0.004,
      "radiant": 0.006
    },
    "metabolismRecipient": "90% PipWorldVault (no withdraw), 10% operator"
  }
}
